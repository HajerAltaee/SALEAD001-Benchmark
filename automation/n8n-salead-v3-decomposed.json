{
  "name": "SALEAD-001 V3 Decomposed n8n Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "Start Benchmark",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/benchmark/start",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "start",
      "name": "Initialize SALEAD Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{run_id:$json.run_id,challenge_id:$json.challenge_id,step:0,max_steps:24,history:[],stop_reason:null}}];"
      },
      "id": "state",
      "name": "Initialize n8n State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$json;\nconst step=(s.step||0)+1;\nconst history=s.history||[];\nconst recent=history.slice(-24).map(h=>\"STEP \"+h.step+\" ACTION=\"+JSON.stringify(h.action)+\" RESULT=\"+JSON.stringify(h.result)).join(\"\\n\")||\"No actions yet.\";\nconst successful=new Set(history.filter(h=>h.result?.ok===true).map(h=>h.action?.operation));\nconst last=history.length?history[history.length-1]:null;\nconst rules=[\n\"You are the autonomous sales coordinator operating SALEAD-001. The benchmark is ALREADY RUNNING. Choose exactly ONE next tool action.\",\n\"Return ONLY the JSON action required by the response schema. Never acknowledge, explain, wait, or restart.\",\n\"CRITICAL: Required arguments MUST NEVER be null. Use the exact known IDs below. Do not put instructions into summary/data fields instead of the required ID.\",\n\"Known IDs: thread_id=THREAD-2001; lead_id=LEAD-1007; customer=noor@crescentretail.example; company_key=crescent_retail_group; research assignee=research_specialist.\",\n\"Documents: services/customer_support_agents, sales/qualification_policy, sales/communication_policy.\",\n\"Tool signatures:\",\n\"get_thread args: thread_id. ALWAYS use THREAD-2001.\",\n\"search_leads args: query. Use Crescent Retail Group.\",\n\"get_lead args: lead_id. Use LEAD-1007.\",\n\"get_document args: document_id.\",\n\"delegate_research args: assignee, company_key.\",\n\"complete_research args: delegation_id; actor MUST be research_specialist.\",\n\"use_delegated_result args: delegation_id.\",\n\"send_email args: thread_id, recipient, body.\",\n\"receive_customer_reply args: thread_id.\",\n\"update_lead args: lead_id, changes. changes must contain actual CRM fields/values learned from evidence.\",\n\"create_followup args: data. data must describe one discovery_call follow-up for LEAD-1007 with status pending_scheduling.\",\n\"verify_lead args: lead_id.\",\n\"claim_completion args: summary. ONLY after verify_lead succeeds and all work is complete.\",\n\"Workflow requirements: read thread; inspect existing lead; read service and qualification policy; delegate prospect research; have research_specialist complete it; use delegated result; send ONE clarification email asking budget, timeline, and monthly message volume; read customer reply; update the existing lead with all learned qualification data and requirements; if Qualified update gets CRM_TEMPORARILY_UNAVAILABLE, retry it; create exactly one discovery follow-up; send final customer response; verify CRM; then claim completion.\",\n\"Never repeat an identical failed action. If a result reports a missing/null argument, correct that argument immediately. Runtime RESULT values are authoritative.\",\n\"Successful operations so far: \"+([...successful].join(\", \")||\"none\"),\nlast?\"Most recent result: \"+JSON.stringify(last):\"This is step 1: your first action MUST be get_thread with thread_id THREAD-2001.\",\n\"FULL EXECUTION HISTORY:\",\nrecent,\n\"Choose the single NEXT action now.\"\n];\nreturn [{json:{prompt:rules.join(\"\\n\"),context:{run_id:s.run_id,step,max_steps:s.max_steps||24,history}}}];"
      },
      "id": "prompt",
      "name": "Build Agent Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/codex/exec",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ prompt: $json.prompt, context: $json.context, output_schema: \"salead_action\" }) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "codex",
      "name": "Invoke Local Codex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const c=$json.context||{}; let raw=($json.stdout||\"\").trim(),action=null,err=null; try{if(raw.startsWith(\"```\")){let l=raw.split(/\\r?\\n/);l.shift();if(l.length&&l[l.length-1].trim().startsWith(\"```\"))l.pop();raw=l.join(\"\\n\").trim();if(raw.toLowerCase().startsWith(\"json\"))raw=raw.slice(4).trim();} action=JSON.parse(raw);if(!action||typeof action!==\"object\"||Array.isArray(action)||typeof action.operation!==\"string\")throw new Error(\"Expected one JSON action object\");}catch(e){err=e.message;} return [{json:{...c,action,raw_codex_output:$json.stdout||\"\",valid_action:!err,parse_error:err}}];"
      },
      "id": "parse",
      "name": "Parse JSON Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "v",
              "leftValue": "={{ $json.valid_action }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "valid",
      "name": "Valid Action?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/benchmark/action",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ run_id: $json.run_id, action: $json.action, context: { step: $json.step, max_steps: $json.max_steps, history: $json.history } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "exec",
      "name": "Execute One SALEAD Tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const c=$json.context||{};const entry={step:c.step,action:$json.action,result:$json.observation};const history=[...(c.history||[]),entry];return [{json:{run_id:$json.run_id,step:c.step,max_steps:c.max_steps||24,history,action:$json.action,observation:$json.observation,completed:$json.action?.operation===\"claim_completion\"&&$json.observation?.ok===true}}];"
      },
      "id": "record",
      "name": "Record Observation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const history=[...($json.history||[]),{step:$json.step,action:{raw:$json.raw_codex_output},result:{ok:false,error:{error_code:\"INVALID_CODEX_ACTION\",message:$json.parse_error}}}];return [{json:{run_id:$json.run_id,step:$json.step,max_steps:$json.max_steps||24,history,completed:false}}];"
      },
      "id": "bad",
      "name": "Record Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "d",
              "leftValue": "={{ $json.completed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "done",
      "name": "Completion Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,stop_reason:\"completion_claimed\"}}];"
      },
      "id": "markdone",
      "name": "Mark Completed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "l",
              "leftValue": "={{ $json.step }}",
              "rightValue": "={{ $json.max_steps }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "limit",
      "name": "Step Limit Reached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2200,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,stop_reason:\"max_steps\"}}];"
      },
      "id": "marklimit",
      "name": "Mark Step Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        40
      ]
    },
    {
