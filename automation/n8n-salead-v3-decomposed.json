        2420,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/benchmark/evaluate",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ run_id: $json.run_id, context: { step: $json.step, history: $json.history, stop_reason: $json.stop_reason } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "eval",
      "name": "Evaluate Actual State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        -140
      ]
    },
    {
      "parameters": {
        "jsCode": "const c=$json.context||{};return [{json:{run_id:$json.run_id,mode:\"decomposed-n8n\",stop_reason:c.stop_reason,steps:c.step,deterministic_score:$json.evaluation?.deterministic_score,final_score:$json.evaluation?.final_score,status:$json.evaluation?.status,evaluation:$json.evaluation,trace:c.history||[],tool_calls:$json.tool_calls}}];"
      },
      "id": "result",
      "name": "Benchmark Result + Trace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        -140
      ]
    }
