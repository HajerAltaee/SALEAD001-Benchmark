{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SALEAD Codex Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "operation",
    "args"
  ],
  "properties": {
    "actor": {
      "type": "string",
      "enum": [
        "sales_coordinator",
        "research_specialist"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "get_thread",
        "search_leads",
        "get_lead",
        "get_document",
        "delegate_research",
        "complete_research",
        "use_delegated_result",
        "send_email",
        "receive_customer_reply",
        "update_lead",
        "create_followup",
        "verify_lead",
        "claim_completion"
      ]
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thread_id": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "lead_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "company_key": {
          "type": "string"
        },
        "delegation_id": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "changes": {
          "type": "object",
          "additionalProperties": true
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
